PORT=8080
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=28800
RESET_TTL_SECONDS=1800

MONGO_URL=mongodb://localhost:27017/meow_matrix
MONGO_DB_NAME=meow_matrix

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Meow Matrix <no-reply@example.test>
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Must resolve to runtime-private persistent storage outside any webroot/source tree.
PRIVATE_STORAGE_ROOT=../.runtime/meow-private

OUTBOX_POLL_MS=5000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=6
FILE_CLEANUP_POLL_MS=60000
FILE_STAGING_RECOVERY_MS=600000
